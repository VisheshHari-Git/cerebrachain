pragma solidity ^0.8.20;

/// Generated by snarkjs from the UpdateChunk circuit (scripts/zk_setup.sh).
interface IGroth16Verifier {
    function verifyProof(
        uint256[2] calldata _pA,
        uint256[2][2] calldata _pB,
        uint256[2] calldata _pC,
        uint256[5] calldata _pubSignals
    ) external view returns (bool);
}

/**
 * @title CerebraChainRegistry
 * @notice Public, tamper-evident record of every federated round:
 *   - which hospitals took part and their X25519 key (used for secure aggregation)
 *   - each hospital's commitment to its (hidden) model update
 *   - the Fiat-Shamir challenge, derived on-chain from all commitments
 *   - on-chain Groth16 verification of every update proof, with the reason for any rejection
 *   - the hash and IPFS CID of each new global model
 *
 * Public signals of one chunk proof: [commitment, evalAtX, sumSq, ctx, x].
 * Hashing conventions match cerebrachain/fields.py and trust-layer/src/protocol.js.
 */
contract CerebraChainRegistry {
    uint256 internal constant R =
        21888242871839275222246405745257275088548364400416034343698204186575808495617;

    enum Phase { None, Commit, Prove, Finalized }
    enum Status { None, Invited, Committed, Accepted, Rejected, Missing }

    struct Round {
        bytes32 globalModelHash;
        uint256 normBound;
        uint32 numChunks;
        Phase phase;
        bytes32 seed;
        bool updated;
        bytes32 newGlobalModelHash;
        string modelCid;
        string note;
    }

    struct Submission {
        Status status;
        bytes32 commitmentRoot;
        bytes32 maskedHash;
        uint256 numSamples;
        uint256 sumSq;
        string reason;
        string proofCid;
    }

    struct Proof {
        uint256[2] a;
        uint256[2][2] b;
        uint256[2] c;
        uint256[5] pub;
    }

    address public immutable aggregator;
    IGroth16Verifier public immutable verifier;

    mapping(uint256 => string) public hospitalName;
    mapping(uint256 => bytes32) public hospitalKey;
    uint256[] public hospitalIds;

    mapping(uint256 => Round) public rounds;
    mapping(uint256 => uint256[]) internal _participants;
    mapping(uint256 => mapping(uint256 => Submission)) public submissions;
    mapping(uint256 => mapping(uint256 => uint256[])) internal _evals;
    uint256 public latestRound;

    event HospitalRegistered(uint256 indexed id, string name, bytes32 x25519Key);
    event RoundOpened(uint256 indexed round, bytes32 globalModelHash, uint256 normBound, uint32 numChunks);
    event UpdateCommitted(uint256 indexed round, uint256 indexed hospitalId, bytes32 commitmentRoot, bytes32 maskedHash);
    event ChallengeIssued(uint256 indexed round, bytes32 seed);
    event UpdateAccepted(uint256 indexed round, uint256 indexed hospitalId, uint256 sumSq);
    event UpdateRejected(uint256 indexed round, uint256 indexed hospitalId, string reason);
    event HospitalMissing(uint256 indexed round, uint256 indexed hospitalId, string reason);
    event RoundFinalized(uint256 indexed round, bool updated, bytes32 newGlobalModelHash, string modelCid, string note);

    modifier onlyAggregator() {
        require(msg.sender == aggregator, "only aggregator");
        _;
    }

    constructor(address verifier_) {
        aggregator = msg.sender;
        verifier = IGroth16Verifier(verifier_);
    }

    // ------------------------------------------------------------------ hashing
    function ctxFor(uint256 round, uint256 hospitalId, bytes32 globalModelHash) public pure returns (uint256) {
        return uint256(sha256(abi.encodePacked("CerebraChain/ctx", round, hospitalId, globalModelHash))) % R;
    }

    function xFor(bytes32 seed, uint256 k) public pure returns (uint256) {
        return uint256(sha256(abi.encodePacked("CerebraChain/x", seed, k))) % R;
    }

    // ------------------------------------------------------------------ registry
    function registerHospital(uint256 id, string calldata name, bytes32 x25519Key) external onlyAggregator {
        if (bytes(hospitalName[id]).length == 0) hospitalIds.push(id);
        hospitalName[id] = name;
        hospitalKey[id] = x25519Key;
        emit HospitalRegistered(id, name, x25519Key);
    }

    function openRound(uint256 r, bytes32 globalModelHash, uint256 normBound, uint32 numChunks, uint256[] calldata ids)
        external
        onlyAggregator
    {
        require(rounds[r].phase == Phase.None, "round exists");
        require(numChunks > 0 && ids.length > 0, "bad params");
        rounds[r].globalModelHash = globalModelHash;
        rounds[r].normBound = normBound;
        rounds[r].numChunks = numChunks;
        rounds[r].phase = Phase.Commit;
        for (uint256 i = 0; i < ids.length; i++) {
            require(bytes(hospitalName[ids[i]]).length != 0, "unknown hospital");
            require(submissions[r][ids[i]].status == Status.None, "duplicate participant");
            submissions[r][ids[i]].status = Status.Invited;
            _participants[r].push(ids[i]);
        }
        latestRound = r;
        emit RoundOpened(r, globalModelHash, normBound, numChunks);
    }

    function commit(uint256 r, uint256 id, bytes32 commitmentRoot, bytes32 maskedHash, uint256 numSamples)
        external
        onlyAggregator
    {
        require(rounds[r].phase == Phase.Commit, "not in commit phase");
        Submission storage s = submissions[r][id];
        require(s.status == Status.Invited, "not invited or already committed");
        s.status = Status.Committed;
        s.commitmentRoot = commitmentRoot;
        s.maskedHash = maskedHash;
        s.numSamples = numSamples;
        emit UpdateCommitted(r, id, commitmentRoot, maskedHash);
    }

    /// Fiat-Shamir: the challenge depends on every commitment and every masked upload,
    /// so no hospital can choose its update after seeing the challenge.
    function closeCommits(uint256 r) external onlyAggregator returns (bytes32 seed) {
        Round storage rd = rounds[r];
        require(rd.phase == Phase.Commit, "not in commit phase");
        bytes memory buf = abi.encodePacked("CerebraChain/seed", r, rd.globalModelHash);
        uint256[] storage ps = _participants[r];
        for (uint256 i = 0; i < ps.length; i++) {
            Submission storage s = submissions[r][ps[i]];
            if (s.status == Status.Committed) {
                buf = abi.encodePacked(buf, ps[i], s.commitmentRoot, s.maskedHash, s.numSamples);
            } else if (s.status == Status.Invited) {
                s.status = Status.Missing;
                s.reason = "no commitment";
                emit HospitalMissing(r, ps[i], "no commitment");
            }
        }
        seed = sha256(buf);
        rd.seed = seed;
        rd.phase = Phase.Prove;
        emit ChallengeIssued(r, seed);
    }

    /// Verifies all chunk proofs of one hospital. Never reverts on a bad proof:
    /// the rejection and its reason are recorded on-chain instead.
    function submitProofs(uint256 r, uint256 id, Proof[] calldata proofs, string calldata proofCid)
        external
        onlyAggregator
        returns (bool accepted)
    {
        Round storage rd = rounds[r];
        require(rd.phase == Phase.Prove, "not in prove phase");
        Submission storage s = submissions[r][id];
        require(s.status == Status.Committed, "not committed");
        s.proofCid = proofCid;

        (string memory reason, uint256 total) = _check(rd, r, id, s.commitmentRoot, proofs);
        s.sumSq = total;
        if (bytes(reason).length != 0) {
            s.status = Status.Rejected;
            s.reason = reason;
            emit UpdateRejected(r, id, reason);
            return false;
        }
        for (uint256 k = 0; k < proofs.length; k++) _evals[r][id].push(proofs[k].pub[1]);
        s.status = Status.Accepted;
        emit UpdateAccepted(r, id, total);
        return true;
    }

    function _check(Round storage rd, uint256 r, uint256 id, bytes32 root, Proof[] calldata proofs)
        internal
        view
        returns (string memory reason, uint256 total)
    {
        if (proofs.length != rd.numChunks) return ("wrong number of chunk proofs", 0);
        uint256 ctx = ctxFor(r, id, rd.globalModelHash);
        bytes memory commitments = new bytes(0);
        for (uint256 k = 0; k < proofs.length; k++) {
            uint256[5] calldata p = proofs[k].pub;
            if (p[3] != ctx) return ("proof bound to another round, hospital or model", 0);
            if (p[4] != xFor(rd.seed, k)) return ("proof not made for this round's challenge", 0);
            commitments = abi.encodePacked(commitments, p[0]);
            total += p[2];
        }
        if (sha256(commitments) != root) return ("proof does not match the committed update", total);
        if (total > rd.normBound) return ("update norm exceeds bound (possible poisoning)", total);
        for (uint256 k = 0; k < proofs.length; k++) {
            if (!verifier.verifyProof(proofs[k].a, proofs[k].b, proofs[k].c, proofs[k].pub)) {
                return ("invalid zk-SNARK proof", total);
            }
        }
        return ("", total);
    }

    function markMissing(uint256 r, uint256 id, string calldata reason) external onlyAggregator {
        Submission storage s = submissions[r][id];
        require(s.status == Status.Committed || s.status == Status.Invited, "cannot mark");
        s.status = Status.Missing;
        s.reason = reason;
        emit HospitalMissing(r, id, reason);
    }

    function finalizeRound(uint256 r, bool updated, bytes32 newGlobalModelHash, string calldata modelCid, string calldata note)
        external
        onlyAggregator
    {
        Round storage rd = rounds[r];
        require(rd.phase == Phase.Prove || rd.phase == Phase.Commit, "cannot finalize");
        rd.phase = Phase.Finalized;
        rd.updated = updated;
        rd.newGlobalModelHash = newGlobalModelHash;
        rd.modelCid = modelCid;
        rd.note = note;
        emit RoundFinalized(r, updated, newGlobalModelHash, modelCid, note);
    }

    // ------------------------------------------------------------------ views
    function participants(uint256 r) external view returns (uint256[] memory) {
        return _participants[r];
    }

    function evals(uint256 r, uint256 id) external view returns (uint256[] memory) {
        return _evals[r][id];
    }

    function numHospitals() external view returns (uint256) {
        return hospitalIds.length;
    }
}
